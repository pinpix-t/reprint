{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": "/bin/bash -c \"cd /app/backend && export PYTHONPATH=/app/backend && /app/backend/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}\""
  }
}

